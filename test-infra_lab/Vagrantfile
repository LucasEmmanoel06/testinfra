Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "web-server"

  # SSH: VM porta 22 -> Windows porta 2222
  # id: "ssh" substitui o encaminhamento SSH padrão do Vagrant (que usa 2222)
  config.vm.network "forwarded_port",
    guest: 22,
    host: 2222,
    host_ip: "0.0.0.0",
    id: "ssh"

  # HTTP: VM porta 80 -> Windows porta 8080
  config.vm.network "forwarded_port",
    guest: 80,
    host: 8080

  config.vm.provider "virtualbox" do |vb|
    vb.name = "test-infra-web"
    vb.memory = 1024
    vb.cpus = 1
  end
end